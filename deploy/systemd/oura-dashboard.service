[Unit]
Description=Oura local-first health dashboard
Documentation=file:/srv/oura/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oura
Group=oura
WorkingDirectory=/srv/oura
EnvironmentFile=-/etc/oura/oura.env
# The oura-dashboard binary reads its whole config from the environment file:
# OURA_RING_DB, OURA_MANUAL_DB, OURA_BIND, OURA_PORT, OURA_TZ_OFFSET and
# OURA_PUBLIC_ORIGIN. No flags are passed here, so the env file is the single
# place to change behavior.
#
# OURA_HUB_DB, OURA_HUB_KEYS and OURA_HUB_BIND are consumed by the separate
# hub service (crates/oura-hub), not by this one: the dashboard only reads the
# hub's SQLite file through OURA_HUB_DB and never accepts uploads itself.
ExecStart=/srv/oura/bin/oura-dashboard
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# UNVERIFIED hardening: there is no LXC yet. Re-check each directive on first
# deployment; relax only with a comment saying which one and why.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The dashboard writes only under its data root; the ring database is opened read-only.
ReadWritePaths=/srv/oura

[Install]
WantedBy=multi-user.target
