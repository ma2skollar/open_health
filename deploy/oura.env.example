# Oura dashboard configuration.
# Copy to /etc/oura/oura.env and replace every __PLACEHOLDER__.
# Mode 0640, owned root:oura. It contains NO secrets: the ring authentication key
# is never stored here, never in this repository, and never in a unit file.

# Ring database (read-only for the dashboard).
OURA_RING_DB=__RING_DB__

# Manual calorie/weight database. Owned by the application; never replaced by
# ring ingestion. Backed up first.
OURA_MANUAL_DB=__MANUAL_DB__

# Loopback port the dashboard listens on. The reverse proxy forwards to it.
OURA_PORT=8090

# Address the dashboard listens on. Left unset (or empty) the dashboard stays on
# loopback, so nothing on the LAN can reach it. To open the dashboard from another
# machine, set this to the address this host has on your LAN — `hostname -I`
# prints it. That is only safe behind a firewall or a VPN, never with the port
# forwarded from the internet.
# OURA_BIND=<lan-address>

# Exact browser origin for a LAN/VPN TLS reverse proxy. No path or credentials.
# Keep unset for direct access. This grants no authentication; firewall the proxy.
# Restart oura-dashboard.service after changing it.
# OURA_PUBLIC_ORIGIN=https://health.example.com

# Timezone offset in hours from UTC for displayed times, e.g. 1 or 5.5.
OURA_TZ_OFFSET=__TZ_OFFSET__

# Directory holding the collector token file, once collector ingestion exists.
# The token itself is a separate 0600 file, never a value in this file.
# The hub's SQLite path. Read by the dashboard (GET /api/status and the
# background analysis worker) and written by the hub service. Default: the
# dashboard binary falls back to OURA_RING_DB's path when unset.
OURA_HUB_DB=/srv/oura/data/hub/ingest.db

# Directory holding the hub's collector auth keys (OURA_HUB_KEYS) and listen
# address (OURA_HUB_BIND, default [IP_ADDRESS]:8787). Consumed by the separate
# hub service, never by the dashboard binary; kept here so one file documents
# the whole stack.
# OURA_HUB_KEYS=/etc/oura/hub-keys.json
# OURA_HUB_BIND=[IP_ADDRESS]:8787

OURA_HUB_STATE_DIR=__HUB_STATE_DIR__
